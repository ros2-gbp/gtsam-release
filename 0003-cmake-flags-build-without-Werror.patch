From 3767193ee607c67c54c1ffaf3597d69138acc160 Mon Sep 17 00:00:00 2001
From: Jose Luis Blanco-Claraco <joseluisblancoc@gmail.com>
Date: Tue, 29 Sep 2026 11:00:52 +0200
Subject: [PATCH 3/3] cmake flags: build without -Werror

---
 rpm/template.spec.em | 1 +
 1 file changed, 1 insertion(+)

diff --git a/rpm/template.spec.em b/rpm/template.spec.em
index 9a1f344..0a5c8fe 100644
--- a/rpm/template.spec.em
+++ b/rpm/template.spec.em
@@ -51,6 +51,7 @@ mkdir -p .obj-%{_target_platform} && cd .obj-%{_target_platform}
     -DGTSAM_USE_SYSTEM_EIGEN=ON \
     -DGTSAM_ENABLE_BOOST_SERIALIZATION=OFF \
     -DGTSAM_USE_BOOST_FEATURES=OFF \
+    -DGTSAM_BUILD_WITH_WERROR=OFF \
 %if !0%{?with_tests}
     -DBUILD_TESTING=OFF \
 %endif
