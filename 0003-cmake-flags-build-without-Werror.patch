From: Jose Luis Blanco-Claraco <joseluisblancoc@gmail.com>
Date: Tue, 29 Sep 2026 11:00:54 +0200
Subject: [PATCH 3/3] cmake flags: build without -Werror

---
 rpm/ros-kilted-gtsam.spec | 1 +
 1 file changed, 1 insertion(+)

diff --git a/rpm/ros-kilted-gtsam.spec b/rpm/ros-kilted-gtsam.spec
index 9533a46..96b5c58 100644
--- a/rpm/ros-kilted-gtsam.spec
+++ b/rpm/ros-kilted-gtsam.spec
@@ -59,6 +59,7 @@ gtsam
     -DGTSAM_USE_SYSTEM_EIGEN=ON \
     -DGTSAM_ENABLE_BOOST_SERIALIZATION=OFF \
     -DGTSAM_USE_BOOST_FEATURES=OFF \
+    -DGTSAM_BUILD_WITH_WERROR=OFF \
 %if !0%{?with_tests}
     -DBUILD_TESTING=OFF \
 %endif
