From 45449e0de324ce0ca56353cbd641589c58be679f Mon Sep 17 00:00:00 2001
From: Jose Luis Blanco-Claraco <joseluisblancoc@gmail.com>
Date: Tue, 29 Sep 2026 10:59:58 +0200
Subject: [PATCH 2/3] cmake flags: disable Boost features

---
 rpm/template.spec.em | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/rpm/template.spec.em b/rpm/template.spec.em
index 14ee4ff..b549d2c 100644
--- a/rpm/template.spec.em
+++ b/rpm/template.spec.em
@@ -51,6 +51,8 @@ mkdir -p .obj-%{_target_platform} && cd .obj-%{_target_platform}
     -DCMAKE_PREFIX_PATH="@(InstallationPrefix)" \
     -DSETUPTOOLS_DEB_LAYOUT=OFF \
     -DGTSAM_USE_SYSTEM_EIGEN=ON \
+    -DGTSAM_ENABLE_BOOST_SERIALIZATION=OFF \
+    -DGTSAM_USE_BOOST_FEATURES=OFF \
 %if !0%{?with_tests}
     -DBUILD_TESTING=OFF \
 %endif
-- 
